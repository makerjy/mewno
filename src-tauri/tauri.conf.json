{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mewno",
  "version": "0.1.3",
  "identifier": "app.mewno.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mewno",
        "width": 1160,
        "height": 810,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/mewno-decode"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "resources": [
      "notices/"
    ],
    "fileAssociations": [
      {
        "ext": [
          "wav",
          "mp3",
          "m4a",
          "mp4",
          "mov",
          "aif",
          "aiff",
          "caf",
          "flac"
        ],
        "contentTypes": [
          "public.audio",
          "public.movie"
        ],
        "name": "Audio and video",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
